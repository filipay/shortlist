# Copy to `.env` (which is gitignored and never committed) and adjust as needed.

# --- opencode backend (external, user-managed — D-05/D-06) -------------------
# Default is the Docker host bridge; leave unset unless your server is elsewhere.
OPENCODE_BASE_URL=http://host.docker.internal:4096

# D-10: the env var that selects the model. Documented cheap default; there is
# no model-picker UI in Phase 1.
OPENCODE_MODEL=deepseek-v4.1-flash

# Health/discovery request timeout in seconds (default 5). Bounded so a hung probe
# cannot pin the single worker. This is NOT the completion timeout below.
OPENCODE_TIMEOUT_SECONDS=5

# How long ONE structured completion may take, in seconds (default 120). A real
# completion is orders of magnitude slower than a health probe, so it has its own
# ceiling rather than reusing OPENCODE_TIMEOUT_SECONDS.
OPENCODE_COMPLETION_TIMEOUT_SECONDS=120

# How many times the CLIENT resends a completion that failed at the transport
# layer (default 2). A schema failure is never retried client-side.
OPENCODE_MAX_RETRIES=2

# How many times the SERVER re-asks the model when its output fails the JSON
# Schema (default 2). Sent as `format.retryCount`.
OPENCODE_STRUCTURED_RETRY_COUNT=2

# D-07: optional. Only set if your opencode server requires auth. This is a
# LOCAL LLM credential — it is not a portal credential and must never be
# committed or hard-coded.
OPENCODE_SERVER_PASSWORD=
