# Copy to `.env` (which is gitignored and never committed) and adjust as needed.

# --- opencode backend (external, user-managed — D-05/D-06) -------------------
# Default is the Docker host bridge; leave unset unless your server is elsewhere.
OPENCODE_BASE_URL=http://host.docker.internal:4096

# D-10: the env var that selects the model. Under the opencode V2 `generate`
# contract there is no forced tool call and no server-side schema (structured
# output is enforced client-side by embedding the JSON schema in the prompt), so
# the old forced-tool-call model requirement no longer applies. `minimax-m3` remains the shipped default, matching the declared
# default and compose.yml. The id MUST exist on the running server: verify it is
# present in `GET /api/model` (auth required), or resolve it via discovery. A
# different provider set may need a different choice — confirm a candidate with the
# "Test LLM backend" button on /settings.
OPENCODE_MODEL=minimax-m3

# Health/detection/session request timeout in seconds (default 5). Bounded so a
# hung probe cannot pin the single worker. Deliberately SHORT: this is the
# `/health` liveness ceiling, so a backend that is down cannot make a health check
# hang. This is NOT the completion timeout below, and NOT the discovery timeout
# below either.
OPENCODE_TIMEOUT_SECONDS=5

# Model-discovery (registry) request timeout in seconds (default 30). Discovery
# walks `GET /api/model` + `GET /api/provider`, which a cold or large server
# answers far more slowly than the liveness probe (measured live: a 5-second
# budget raised ReadTimeout while the same endpoints answered in ~19 ms via curl),
# so it gets a generous budget of its own. Kept SEPARATE from
# OPENCODE_TIMEOUT_SECONDS so the health probe stays short.
OPENCODE_DISCOVERY_TIMEOUT_SECONDS=30

# How long ONE structured completion may take, in seconds (default 120). A real
# completion is orders of magnitude slower than a health probe, so it has its own
# ceiling rather than reusing OPENCODE_TIMEOUT_SECONDS.
OPENCODE_COMPLETION_TIMEOUT_SECONDS=300

# How many times the CLIENT resends a completion that failed at the transport
# layer (default 2). Transport-only — schema retries have their own budget below.
OPENCODE_MAX_RETRIES=2

# How many times the CLIENT re-asks the model when its output fails the JSON
# Schema (default 2). This is the CLIENT-side schema-retry budget: V2 has no
# server-side schema, so no `format.retryCount` is sent.
OPENCODE_STRUCTURED_RETRY_COUNT=2

# How long to wait before the ONE bounded re-probe of `GET /api/model` after an
# empty result, in seconds (default 2). A freshly started server populates its
# model registry lazily (measured: ~32s on 2.0.26), so an immediate re-probe sees
# nothing. Kept short on purpose: a request is never pinned for the full warm
# window; an empty registry is reported as the distinct `models_warming` cause.
OPENCODE_DISCOVERY_RETRY_DELAY_SECONDS=2

# D-07/D-135: REQUIRED in practice under the opencode V2 API. `opencode serve`
# (2.0.26) has no unsecured mode: it ALWAYS auto-generates and prints a password
# at startup (`server password <43 chars>`, right after `server listening on …`),
# and every `/api/*` call returns 401 without it. Setting this to an empty value
# does NOT disable the server-side password — it just yields a 401, reported as
# `unauthenticated`. So copy the password the server prints at startup into here.
# An alternative is the documented pairing flow: `POST /api/pair` returns a
# single-use code, then `GET /auth/connect/{code}` returns the token to use here.
# Re-copy it after a server restart (the lifetime across restarts is undocumented).
# This is a LOCAL LLM credential — it is not a portal credential; the app only
# consumes it, never generating or storing it. Never commit it.
OPENCODE_SERVER_PASSWORD=

# --- LaTeX engine (CV-05 / PLAT-04) ------------------------------------------
# A host-side override here only reaches the container because compose.yml
# forwards each key (`${VAR:-default}`); without that passthrough the in-code
# default silently wins.

# Which engine compiles the CV. `tectonic` (default) or `texlive` (the fallback
# image, Dockerfile.texlive). The factory never falls back to the other engine.
LATEX_ENGINE=tectonic

# The pinned Tectonic binary installed by the Dockerfile. Default matches the
# image install path.
TECTONIC_BINARY=/usr/local/bin/tectonic

# The Tectonic package cache. MUST equal the image ENV value, or a runtime
# compile looks in a cache the build never primed and fails offline.
TECTONIC_CACHE_DIR=/opt/tectonic-cache

# Refuse the network on every runtime compile (`--only-cached`). The build-time
# prime is the only networked engine invocation.
TECTONIC_OFFLINE=true

# Per-compile ceiling in seconds for BOTH engines, so a hung engine cannot pin
# the single worker.
TECTONIC_TIMEOUT_SECONDS=60

# The `/health` `--version` probe ceiling in seconds (default 5). Deliberately
# short: the probe runs on every health request and must never approach the
# compile ceiling. This is NOT the compile ceiling above.
LATEX_PROBE_TIMEOUT_SECONDS=5.0

# How many characters of the engine log the bounded tail carries (default 4000),
# so a noisy engine cannot attach an unbounded log to every failure value.
LATEX_LOG_TAIL_CHARS=4000

# The TeX Live fallback binary. Deliberately xelatex, never pdflatex (pdflatex
# cannot load fontspec).
LATEX_XELATEX_BINARY=/usr/bin/xelatex

# The fact-store volume root (mounted ./cv:/cv).
CV_DIR=/cv

# The artefact volume root (mounted ./artifacts:/artifacts).
ARTIFACTS_DIR=/artifacts

# The bounded .tex importer: line cap and nesting-depth cap.
TEX_IMPORT_MAX_LINES=20000
TEX_IMPORT_MAX_DEPTH=12

# --- Ranking spend caps (RANK-08) --------------------------------------------
# A host-side override here only reaches the container because compose.yml
# forwards each key (`${VAR:-default}`); without that passthrough the in-code
# default silently wins.

# The maximum ranking calls in ONE run (default 40). A call is refused BEFORE it
# is issued when either this ceiling or the rolling-24h ceiling below would be
# reached — a cap checked after the call is not a cap. This is a CALL count, not
# a token budget: a call's token cost is unknowable before the call.
RANKING_MAX_CALLS_PER_RUN=40

# The maximum ranking calls in any trailing 24 hours (default 400), counted over
# the `llm_calls` ledger. Refusal semantics are identical to the per-run ceiling.
RANKING_MAX_CALLS_PER_DAY=400

# The operator off switch (default true). Set to false and a run ingests exactly
# as it does today — no ranking calls, no scores, no `llm_calls` rows — without
# editing code or removing the ranking call site.
RANKING_ENABLED=true
